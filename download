function calcSim() {
    if (!simItem) return;
    const qty = parseFloat(document.getElementById('simQty').value);
    const sellPrice = parseFloat(document.getElementById('simSellPrice').value);
    const costs = parseFloat(document.getElementById('simCosts').value) || 0;
    const taxRate = parseFloat(document.querySelector('input[name="taxRate"]:checked').value);
    if (!qty || !sellPrice || qty <= 0 || sellPrice <= 0) {
        document.getElementById('simResults').style.display = 'none';
        return;
    }
    const isUSD = simItem.currency === 'USD';
    const buyPriceRaw = isUSD ? (simItem.buyPriceUSD || simItem.buyPrice) : simItem.buyPrice;
    const buyCostsTotal = simItem.buyCosts || 0;
    const buyPriceAvg = buyPriceRaw + (buyCostsTotal / simItem.quantity);
    const gross = qty * sellPrice;
    const netIncome = gross - costs;
    const buyCostSim = qty * buyPriceAvg;
    const pl = netIncome - buyCostSim;
    const tax = pl > 0 ? pl * taxRate : 0;
    const plNet = pl - tax;
    const breakevenRaw = buyPriceAvg;
    const breakevenWithComm = buyPriceAvg + (costs / qty);
    const roi = (plNet / buyCostSim) * 100;
    const sym = isUSD ? '$' : '€';
    const fmt = (v) => sym + formatNumber(Math.abs(v), 2);

    document.getElementById('simGross').textContent = fmt(gross);
    document.getElementById('simCostOut').textContent = '− ' + sym + formatNumber(costs, 2);
    document.getElementById('simNet').textContent = fmt(netIncome);
    document.getElementById('simNet').className = netIncome >= 0 ? 'sim-positive' : 'sim-negative';
    document.getElementById('simBuyAvg').textContent = sym + formatNumber(buyPriceAvg, 4);
    document.getElementById('simBuyCost').textContent = fmt(buyCostSim);
    document.getElementById('simPL').textContent = (pl >= 0 ? '+' : '−') + fmt(pl);
    document.getElementById('simPL').className = pl >= 0 ? 'sim-positive' : 'sim-negative';
    document.getElementById('simTax').textContent = pl > 0 ? '− ' + fmt(tax) + ' (' + (taxRate*100) + '%)' : 'Sin impuesto (pérdida)';
    document.getElementById('simPLNet').textContent = (plNet >= 0 ? '+' : '−') + fmt(plNet);
    document.getElementById('simPLNet').className = plNet >= 0 ? 'sim-positive' : 'sim-negative';
    document.getElementById('simBreakeven').textContent = sym + formatNumber(breakevenRaw, 4);
    document.getElementById('simBreakevenComm').textContent = sym + formatNumber(breakevenWithComm, 4);
    document.getElementById('simROI').textContent = (roi >= 0 ? '+' : '') + formatNumber(roi, 2) + '%';
    document.getElementById('simROI').className = roi >= 0 ? 'sim-row sim-positive' : 'sim-row sim-negative';

    const warning = document.getElementById('simWarning');
    if (sellPrice < breakevenWithComm) {
        warning.style.display = 'block';
        warning.textContent = '⚠️ Con este precio no recuperas ni las comisiones. Necesitas al menos ' + sym + formatNumber(breakevenWithComm, 4) + ' para cubrir costes.';
    } else if (pl < 0) {
        warning.style.display = 'block';
        warning.textContent = '⚠️ Esta venta genera pérdidas de ' + fmt(Math.abs(pl)) + '. Podrías compensarlas con otras plusvalías en la declaración.';
    } else {
        warning.style.display = 'none';
    }
    document.getElementById('simResults').style.display = 'block';
}

