function importData(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const imported = JSON.parse(e.target.result);
            if (confirm('\u00bfEst\u00e1s seguro de importar estos datos? Esto sobreescribir\u00e1 tu cartera actual.')) {
                if (imported.portfolioData) {
                    portfolioData = imported.portfolioData;
                    if (imported.manualPrices) {
                        manualPrices = imported.manualPrices;
                        Object.keys(manualPrices).forEach(ticker => {
                            currentPrices[ticker] = manualPrices[ticker];
                        });
                        saveManualPrices();
                    }
                    if (imported.apiPrices) {
                        apiPrices = imported.apiPrices;
                        Object.keys(apiPrices).forEach(ticker => {
                            currentPrices[ticker] = apiPrices[ticker];
                        });
                        saveApiPrices();
                    }
                    if (imported.maxPrices) {
                        maxPrices = imported.maxPrices;
                        saveMaxPrices();
                    }
                    if (imported.stopLossPrices) {
                        stopLossPrices = imported.stopLossPrices;
                        saveStopLossPrices();
                    }
                    if (imported.targetPrices) {
                        targetPrices = imported.targetPrices;
                        saveTargetPrices();
                    }
                    if (imported.usdToEur) {
                        usdToEur = imported.usdToEur;
                        localStorage.setItem('usdToEur', usdToEur);
                        syncExchangeRateInputs();
                    }
                    if (imported.supportResistance) {
                        supportResistance = imported.supportResistance;
                        saveSupportResistance();
                    }
                    if (imported.aiReport) {
                        saveAiReport(imported.aiReport);
                        const rd = document.getElementById('aiResponse');
                        if (rd) { rd.className = 'ai-response'; rd.textContent = imported.aiReport; }
                    }
                } else {
                    portfolioData = imported;
                }
                savePortfolioData();
                renderYearSelector();
                renderPortfolio();
                alert('\u2705 Datos importados correctamente');
            }
        } catch (error) { alert('\u274c Error al importar datos'); }
    };
    reader.readAsText(file);
}

async function updatePrices() {
    if (currentYear === 'GLOBAL') { alert('⚠️ No se pueden actualizar precios en la vista GLOBAL'); return; }
    const finnhubKey = localStorage.getItem('finnhubApiKey');
    if (!finnhubKey) { alert('⚠️ Por favor, configura tu API Key de Finnhub primero (⚙️ API)'); return; }
    const alphaKey = localStorage.getItem('alphaVantageApiKey'); // opcional: solo para tipo de cambio y soporte/resistencia
    const updateBtn = document.getElementById('updateBtn');
    const loading = document.getElementById('loading');
    updateBtn.disabled = true;
    loading.classList.add('active');
    try {
        if (alphaKey) await getExchangeRate(alphaKey);
        const openPositions = currentYear === 'ACTIVA'
            ? getOpenPositions()
            : (portfolioData[String(currentYear)]?.positions || []).filter(p => !p.sold);
        const pendientes = []; // tickers que se quedan sin actualizar por límite de cuota
        let rateLimitHit = false;
        for (const item of openPositions) {
            if (rateLimitHit) { pendientes.push(item.ticker); continue; }
            if (item.type === 'stock') {
                loading.innerHTML = '<div class="spinner"></div>Actualizando <strong>' + item.ticker + '</strong>...';
                const r1 = await getStockPrice(item.ticker, finnhubKey);
                if (r1.rateLimited) { rateLimitHit = true; pendientes.push(item.ticker); continue; }
                await sleep(1100); // Finnhub: 60 peticiones/min, margen de seguridad
                if (alphaKey) {
                    loading.innerHTML = '<div class="spinner"></div>Calculando soporte/resistencia <strong>' + item.ticker + '</strong>...';
                    await calculateSupportResistance(item.ticker, alphaKey);
                    await sleep(13000); // Alpha Vantage: 5 peticiones/min en el plan gratuito
                }
            } else if (item.type === 'crypto') {
                loading.innerHTML = '<div class="spinner"></div>Actualizando cripto <strong>' + item.ticker + '</strong>...';
                const r2 = await getCryptoPrice(item.ticker);
                if (r2.rateLimited) { rateLimitHit = true; pendientes.push(item.ticker); continue; }
            }
        }
        loading.innerHTML = '<div class="spinner"></div>Actualizando precios y calculando soportes/resistencias...';
        renderPortfolio();
        updateLastUpdateTime();
        // Guardar en Gist con los precios y soportes/resistencias actualizados
        if (gistConfigurado()) {
            clearTimeout(window._gistSaveTimer);
            window._gistSaveTimer = setTimeout(function() { guardarEnGist(false); }, 2000);
        }
        if (rateLimitHit) {
            alert('⏳ Se ha alcanzado el límite de peticiones de la API antes de terminar.\n\nNo se pudieron actualizar: ' + pendientes.join(', ') + '.\n\nEspera unos minutos y vuelve a pulsar "Actualizar Precios", o actualiza esos tickers uno a uno con el botón 🔄 individual.');
        }
    } catch (error) { alert('❌ Error al actualizar precios'); } finally { updateBtn.disabled = false; loading.classList.remove('active'); }
}

async function updateSinglePrice(ticker, type) {
    const finnhubKey = localStorage.getItem('finnhubApiKey');
    if (!finnhubKey) { alert('⚠️ Configura tu API Key de Finnhub primero (⚙️ API)'); return; }
    const alphaKey = localStorage.getItem('alphaVantageApiKey'); // opcional: soporte/resistencia
    const btn = document.getElementById('refresh-' + ticker);
    if (btn) { btn.disabled = true; btn.textContent = '⏳'; }
    try {
        let result;
        if (type === 'stock') {
            result = await getStockPrice(ticker, finnhubKey);
            if (result.ok && alphaKey) {
                await sleep(8000);
                await calculateSupportResistance(ticker, alphaKey);
            }
        } else {
            result = await getCryptoPrice(ticker);
        }
        renderPortfolio();
        if (!result.ok) {
            alert((result.rateLimited ? '⏳ ' : '⚠️ ') + (apiErrors[ticker] ? apiErrors[ticker].msg : 'No se pudo actualizar ' + ticker));
        }
    } catch(e) {
        alert('❌ Error actualizando ' + ticker);
    } finally {
        if (btn) { btn.disabled = false; btn.textContent = '🔄'; }
    }
}

async function getStockPrice(ticker, finnhubKey) {
    try {
        const url = 'https://finnhub.io/api/v1/quote?symbol=' + ticker + '&token=' + finnhubKey;
        const response = await fetch(url);
        if (response.status === 429) {
            apiErrors[ticker] = { msg: 'Límite de peticiones de Finnhub alcanzado (HTTP 429, 60/min). Espera un minuto y reintenta.', rateLimited: true };
            console.warn('⏳ Límite de Finnhub alcanzado (' + ticker + ')');
            return { ok: false, rateLimited: true };
        }
        if (response.status === 401 || response.status === 403) {
            apiErrors[ticker] = { msg: 'Finnhub ha rechazado la API Key (HTTP ' + response.status + '). Revisa que la Key sea correcta en ⚙️ API.', rateLimited: false };
            console.warn('🔒 Finnhub rechazó la key para ' + ticker, response.status);
            return { ok: false, rateLimited: false };
        }
        const data = await response.json();
        // Finnhub devuelve todo a 0 cuando el símbolo no existe o no tiene datos, sin dar error HTTP
        if (data && typeof data.c === 'number' && data.c > 0) {
            const price = data.c; // 'c' = current price
            currentPrices[ticker] = price;
            apiPrices[ticker] = price;
            delete manualPrices[ticker];
            delete apiErrors[ticker];
            // Update trailing max
            if (!maxPrices[ticker] || price > maxPrices[ticker]) {
                maxPrices[ticker] = price;
                saveMaxPrices();
            }
            saveApiPrices();
            saveManualPrices();
            console.log('✅ ' + ticker + ': $' + price);
            return { ok: true, rateLimited: false };
        } else {
            apiErrors[ticker] = { msg: 'Finnhub no devolvió datos para "' + ticker + '" (ticker no reconocido o sin cotización)', rateLimited: false };
            console.warn('⚠️ Sin datos para ' + ticker, data);
            return { ok: false, rateLimited: false };
        }
    } catch (error) {
        apiErrors[ticker] = { msg: 'Error de red al consultar Finnhub: ' + error.message, rateLimited: false };
        console.error('❌ Error ' + ticker + ':', error);
        return { ok: false, rateLimited: false };
    }
}

async function getCryptoPrice(symbol) {
    // Mapa de ticker → id de CoinGecko
    const coinGeckoIds = {
        'BTC':  'bitcoin',
        'ETH':  'ethereum',
        'SOL':  'solana',
        'BNB':  'binancecoin',
        'ADA':  'cardano',
        'XRP':  'ripple',
        'DOT':  'polkadot',
        'DOGE': 'dogecoin',
        'AVAX': 'avalanche-2',
        'MATIC':'matic-network',
        'LINK': 'chainlink',
        'LTC':  'litecoin',
    };
    const coinId = coinGeckoIds[symbol.toUpperCase()] || symbol.toLowerCase();
    try {
        const url = 'https://api.coingecko.com/api/v3/simple/price?ids=' + coinId + '&vs_currencies=usd';
        const response = await fetch(url);
        if (response.status === 429) {
            apiErrors[symbol] = { msg: 'Límite de peticiones de CoinGecko alcanzado (HTTP 429). Espera un minuto y reintenta.', rateLimited: true };
            console.warn('⏳ Límite de CoinGecko alcanzado (' + symbol + ')');
            return { ok: false, rateLimited: true };
        }
        const data = await response.json();
        if (data[coinId] && data[coinId].usd) {
            const price = data[coinId].usd;
            currentPrices[symbol] = price;
            apiPrices[symbol] = price;
            delete manualPrices[symbol];
            delete apiErrors[symbol];
            if (!maxPrices[symbol] || price > maxPrices[symbol]) {
                maxPrices[symbol] = price;
                saveMaxPrices();
            }
            saveApiPrices();
            saveManualPrices();
            console.log('✅ ' + symbol + ': $' + price);
            return { ok: true, rateLimited: false };
        } else {
            apiErrors[symbol] = { msg: 'CoinGecko no devolvió datos para "' + symbol + '" (id buscado: ' + coinId + ')', rateLimited: false };
            console.warn('⚠️ Sin datos para ' + symbol + ' (id: ' + coinId + ')', data);
            return { ok: false, rateLimited: false };
        }
    } catch (error) {
        apiErrors[symbol] = { msg: 'Error de red al consultar CoinGecko: ' + error.message, rateLimited: false };
        console.error('Error cripto ' + symbol + ':', error);
        return { ok: false, rateLimited: false };
    }
}

function syncExchangeRateInputs() {
    const usdEurEl = document.getElementById('usdEurInput');
    const eurUsdEl = document.getElementById('eurUsdInput');
    if (!usdToEur || usdToEur <= 0) return;
    if (usdEurEl) usdEurEl.value = usdToEur.toFixed(4);
    if (eurUsdEl) eurUsdEl.value = (1 / usdToEur).toFixed(4);
}

function setExchangeRateStatus(text, color) {
    const el = document.getElementById('exchangeRateStatus');
    if (!el) return;
    el.textContent = text || '';
    el.style.color = color || '#94a3b8';
}

async function getExchangeRate(apiKey) {
    try {
        const url = 'https://www.alphavantage.co/query?function=CURRENCY_EXCHANGE_RATE&from_currency=USD&to_currency=EUR&apikey=' + apiKey;
        const response = await fetch(url);
        if (!response.ok) {
            return { ok: false, message: 'Alpha Vantage devolvió HTTP ' + response.status };
        }
        const data = await response.json();
        const fx = data['Realtime Currency Exchange Rate'];
        const rate = fx ? parseFloat(fx['5. Exchange Rate']) : NaN;
        if (!isNaN(rate) && rate > 0) {
            usdToEur = rate;
            localStorage.setItem('usdToEur', usdToEur);
            syncExchangeRateInputs();
            setExchangeRateStatus('🔄 Alpha Vantage · ' + new Date().toLocaleTimeString('es-ES', {hour:'2-digit', minute:'2-digit'}), '#0ea5e9');
            return { ok: true, rate: rate };
        }
        const msg = data.Note || data.Information || data['Error Message'] || 'Alpha Vantage no devolvió un tipo de cambio válido';
        return { ok: false, message: msg };
    } catch (error) {
        console.error('Error tipo de cambio:', error);
        return { ok: false, message: 'Error de conexión con Alpha Vantage: ' + error.message };
    }
}

async function refreshExchangeRateFromApi() {
    const apiKey = localStorage.getItem('alphaVantageApiKey');
    if (!apiKey) {
        alert('⚠️ Configura primero tu API Key de Alpha Vantage en ⚙️ API');
        return;
    }
    const btn = document.getElementById('exchangeApiBtn');
    if (btn) { btn.disabled = true; btn.textContent = '⏳'; }
    setExchangeRateStatus('Consultando Alpha Vantage...', '#64748b');
    const result = await getExchangeRate(apiKey);
    if (btn) { btn.disabled = false; btn.textContent = '🔄 API'; }
    if (result && result.ok) {
        renderPortfolio();
    } else {
        setExchangeRateStatus('⚠️ No se pudo actualizar con la API', '#dc2626');
        alert('⚠️ ' + ((result && result.message) || 'No se pudo obtener el tipo de cambio'));
    }
}

async function calculateSupportResistance(ticker, apiKey) {
    try {
        const url = 'https://www.alphavantage.co/query?function=TIME_SERIES_DAILY&symbol=' + ticker + '&outputsize=compact&apikey=' + apiKey;
        const response = await fetch(url);
        const data = await response.json();
        if (data['Time Series (Daily)']) {
            const timeSeries = data['Time Series (Daily)'];
            const prices = [];
            let count = 0;
            for (const date in timeSeries) {
                if (count >= 30) break;
                prices.push(parseFloat(timeSeries[date]['4. close']));
                count++;
            }
            if (prices.length > 0) {
                const sortedPrices = [...prices].sort((a, b) => a - b);
                supportResistance[ticker] = {
                    support1: sortedPrices[Math.floor(sortedPrices.length * 0.15)],
                    support2: sortedPrices[Math.floor(sortedPrices.length * 0.05)],
                    resistance1: sortedPrices[Math.floor(sortedPrices.length * 0.85)],
                    resistance2: sortedPrices[Math.floor(sortedPrices.length * 0.95)]
                };
                saveSupportResistance();
            }
        }
    } catch (error) { console.error('Error:', error); }
}

