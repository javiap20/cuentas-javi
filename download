        if (!buyPrice || buyPrice <= 0) { alert('⚠️ Por favor, introduce el precio de compra en €'); return; }
        pos.buyPrice = buyPrice;
        delete pos.buyPriceUSD; delete pos.buyPriceEUR;
    }

    pos.sold = isSold;
    if (!isSold) {
        // Las posiciones nuevas ya vienen clasificadas. Para las antiguas sin clasificar no forzamos nada.
