async function loadFromGitHub() {
    // Ahora delegamos en cargarDesdeGist
    return await cargarDesdeGist();
}

async function cargarDesdeGist() {
    mostrarFuenteDatos('cargando');
    try {
        const resp = await fetch('https://api.github.com/gists/' + GIST_ID, {
            headers: gistConfigurado() ? { 'Authorization': 'token ' + gistToken() } : {}
        });
        if (!resp.ok) { mostrarFuenteDatos('local'); return false; }
        const gist = await resp.json();
        const file = gist.files && gist.files[GIST_FILENAME];
        if (!file || !file.content) { mostrarFuenteDatos('local'); return false; }

        const data = JSON.parse(file.content);
        const fechaGist = data._exportadoEn || null;
        const fechaLocal = localStorage.getItem('gistLastSavedCartera');

        // Si local es más reciente que el Gist, avisar pero usar local
        if (fechaLocal && fechaGist && fechaLocal > fechaGist) {
            mostrarFuenteDatos('local-nuevo', fechaLocal);
            return false;
        }

        // Aplicar datos del Gist
        const remotePortfolio = data.portfolioData || data;
        if (!remotePortfolio || Object.keys(remotePortfolio).length === 0) { mostrarFuenteDatos('local'); return false; }

        portfolioData = {};
        Object.keys(remotePortfolio).forEach(k => {
            portfolioData[String(k)] = remotePortfolio[k];
            if (portfolioData[String(k)].positions) {
                portfolioData[String(k)].positions.forEach(p => {
                    if (!p.id) p.id = 'pos_' + Date.now() + '_' + Math.random().toString(36).substr(2,5);
                });
            }
        });
        if (data.manualPrices)  { manualPrices = data.manualPrices;   Object.keys(manualPrices).forEach(t => { currentPrices[t] = manualPrices[t]; }); saveManualPrices(); }
        if (data.apiPrices)     { apiPrices = data.apiPrices;         Object.keys(apiPrices).forEach(t => { currentPrices[t] = apiPrices[t]; }); saveApiPrices(); }
        if (data.maxPrices)     { maxPrices = data.maxPrices;         saveMaxPrices(); }
        if (data.stopLossPrices){ stopLossPrices = data.stopLossPrices; saveStopLossPrices(); }
        if (data.targetPrices)  { targetPrices = data.targetPrices;   saveTargetPrices(); }
        if (data.usdToEur)      { usdToEur = data.usdToEur; localStorage.setItem('usdToEur', usdToEur); syncExchangeRateInputs(); }
        if (data.supportResistance) { supportResistance = data.supportResistance; saveSupportResistance(); }
        if (data.aiReport)      { saveAiReport(data.aiReport); const rd = document.getElementById('aiResponse'); if (rd) { rd.className = 'ai-response'; rd.textContent = data.aiReport; } }

        localStorage.setItem('portfolioData', JSON.stringify(portfolioData));
        mostrarFuenteDatos('gist', fechaGist);
        return true;
    } catch (e) {
        console.log('Error cargando Gist:', e);
        mostrarFuenteDatos('local');
        return false;
    }
}

async function guardarEnGist(manual) {
    if (!gistConfigurado()) {
        if (manual) alert('⚠️ Configura primero el token Gist (botón 🔑 Gist)');
        return;
    }
    const payload = {
        _exportadoEn: new Date().toISOString(),
        portfolioData, manualPrices, apiPrices, maxPrices, targetPrices, stopLossPrices, usdToEur,
        supportResistance, aiReport: loadAiReport()
    };
    try {
        const resp = await fetch('https://api.github.com/gists/' + GIST_ID, {
            method: 'PATCH',
            headers: { 'Authorization': 'token ' + gistToken(), 'Content-Type': 'application/json' },
            body: JSON.stringify({ files: { [GIST_FILENAME]: { content: JSON.stringify(payload, null, 2) } } })
        });
        if (resp.ok) {
            localStorage.setItem('gistLastSavedCartera', payload._exportadoEn);
            mostrarFuenteDatos('gist', payload._exportadoEn);
            if (manual) alert('☁️ Guardado en Gist correctamente');
        } else {
            if (manual) alert('❌ Error al guardar en Gist (' + resp.status + ')');
        }
    } catch (e) {
        if (manual) alert('❌ Sin conexión al guardar en Gist');
    }
}

