function updateSummary(totalInvestedEUR, totalCurrentEUR, stocksInvestedEUR, stocksCurrentEUR) {
    // Bloque Total (acciones + cripto)
    const totalPL = totalCurrentEUR - totalInvestedEUR;
    const totalPLPercent = totalInvestedEUR > 0 ? ((totalPL / totalInvestedEUR) * 100) : 0;
    document.getElementById('totalInvested').textContent = formatEUR0(totalInvestedEUR);
    document.getElementById('currentValue').textContent = formatEUR0(totalCurrentEUR);
    document.getElementById('totalPL').textContent = (totalPL >= 0 ? '+' : '') + formatEUR0(totalPL);
    document.getElementById('totalPLPercent').textContent = (totalPLPercent >= 0 ? '+' : '') + formatNumber(totalPLPercent, 2) + '%';
    document.getElementById('totalPL').className = totalPL >= 0 ? 'value positive' : 'value negative';
    document.getElementById('totalPLPercent').className = totalPL >= 0 ? 'value positive' : 'value negative';
    // Bloque Solo Acciones
    const stocksPL = stocksCurrentEUR - stocksInvestedEUR;
    const stocksPLPercent = stocksInvestedEUR > 0 ? ((stocksPL / stocksInvestedEUR) * 100) : 0;
    document.getElementById('stocksInvested').textContent = formatEUR0(stocksInvestedEUR);
    document.getElementById('stocksCurrent').textContent = formatEUR0(stocksCurrentEUR);
    document.getElementById('totalPLStocks').textContent = (stocksPL >= 0 ? '+' : '') + formatEUR0(stocksPL);
    document.getElementById('totalPLStocksPercent').textContent = (stocksPLPercent >= 0 ? '+' : '') + formatNumber(stocksPLPercent, 2) + '%';
    document.getElementById('totalPLStocks').className = stocksPL >= 0 ? 'value positive' : 'value negative';
    document.getElementById('totalPLStocksPercent').className = stocksPL >= 0 ? 'value positive' : 'value negative';
    // USD equivalents (sin decimales)
    if (usdToEur > 0) {
        document.getElementById('totalInvestedUSD').textContent = formatUSD0(totalInvestedEUR / usdToEur);
        document.getElementById('currentValueUSD').textContent = formatUSD0(totalCurrentEUR / usdToEur);
        document.getElementById('stocksInvestedUSD').textContent = formatUSD0(stocksInvestedEUR / usdToEur);
        document.getElementById('stocksCurrentUSD').textContent = formatUSD0(stocksCurrentEUR / usdToEur);
    }
}

function editPositionPrice(id, year) {
    const yearKey = String(year);
    const yearData = portfolioData[yearKey];
    if (!yearData || !yearData.positions) return;
    const pos = yearData.positions.find(p => p.id === id);
    if (!pos) return;

    const priceDiv = document.getElementById('price-' + id);
    if (!priceDiv) return;

    if (pos.sold) {
        // En una venta USD conservamos los dos valores historicos: USD y EUR del dia de venta.
        if (pos.currency === 'USD') {
            const usd = Number(pos.sellPriceUSD || 0);
            const eur = Number(pos.sellPriceEUR || 0);
            priceDiv.innerHTML = '<div class="price-edit-stack" onclick="event.stopPropagation()">'
                + '<input type="number" id="input-price-usd-' + id + '" value="' + (usd || '').toString() + '" step="0.01" placeholder="Venta USD" title="Precio de venta en USD">'
                + '<input type="number" id="input-price-eur-' + id + '" value="' + (eur || '').toString() + '" step="0.01" placeholder="Venta EUR" title="Equivalente en EUR del dia de venta">'
                + '<span class="price-edit-hint">Enter = guardar · Esc = cancelar</span>'
                + '<button type="button" class="price-edit-save" onclick="event.stopPropagation();savePositionPrice(\'' + id + '\', \'' + yearKey + '\')">✓ Guardar</button>'
                + '</div>';
            const inputs = [document.getElementById('input-price-usd-' + id), document.getElementById('input-price-eur-' + id)];
            inputs.forEach(input => {
                input.addEventListener('keydown', function(event) {
                    if (event.key === 'Enter') savePositionPrice(id, yearKey);
                    if (event.key === 'Escape') renderPortfolio();
                });
            });
            inputs[0].focus();
            inputs[0].select();
        } else {
            const eur = Number(pos.sellPrice || 0);
            priceDiv.innerHTML = '<div class="price-edit-stack" onclick="event.stopPropagation()">'
                + '<input type="number" id="input-price-eur-' + id + '" value="' + (eur || '').toString() + '" step="0.01" placeholder="Venta EUR" title="Precio de venta en EUR">'
                + '<span class="price-edit-hint">Enter = guardar · Esc = cancelar</span>'
                + '<button type="button" class="price-edit-save" onclick="event.stopPropagation();savePositionPrice(\'' + id + '\', \'' + yearKey + '\')">✓ Guardar</button>'
                + '</div>';
            const input = document.getElementById('input-price-eur-' + id);
            input.addEventListener('keydown', function(event) {
                if (event.key === 'Enter') savePositionPrice(id, yearKey);
                if (event.key === 'Escape') renderPortfolio();
            });
            input.focus();
            input.select();
        }
        return;
    }

    const isUSD = pos.currency === 'USD';
    const currentPrice = Number(currentPrices[pos.ticker] || (isUSD ? pos.buyPriceUSD : pos.buyPrice) || 0);
    priceDiv.innerHTML = '<div class="price-edit-stack" onclick="event.stopPropagation()">'
        + '<input type="number" id="input-price-current-' + id + '" value="' + (currentPrice || '').toString() + '" step="0.01" placeholder="Precio manual">'
        + '<span class="price-edit-hint">' + (isUSD ? 'USD' : 'EUR') + ' · Enter = guardar · Esc = cancelar</span>'
        + '<button type="button" class="price-edit-save" onclick="event.stopPropagation();savePositionPrice(\'' + id + '\', \'' + yearKey + '\')">✓ Guardar</button>'
        + '</div>';
    const input = document.getElementById('input-price-current-' + id);
    input.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') savePositionPrice(id, yearKey);
        if (event.key === 'Escape') renderPortfolio();
    });
    input.focus();
    input.select();
}

function savePositionPrice(id, year) {
    const yearKey = String(year);
    const yearData = portfolioData[yearKey];
    if (!yearData || !yearData.positions) { renderPortfolio(); return; }
    const pos = yearData.positions.find(p => p.id === id);
    if (!pos) { renderPortfolio(); return; }

    if (pos.sold) {
        if (pos.currency === 'USD') {
            const usdInput = document.getElementById('input-price-usd-' + id);
            const eurInput = document.getElementById('input-price-eur-' + id);
            const usd = usdInput ? parseFloat(usdInput.value) : NaN;
            const eur = eurInput ? parseFloat(eurInput.value) : NaN;
            if (!(usd > 0) || !(eur > 0)) {
                alert('⚠️ Introduce precios de venta validos en USD y EUR');
                renderPortfolio();
                return;
            }
            pos.sellPriceUSD = usd;
            pos.sellPriceEUR = eur;
        } else {
            const eurInput = document.getElementById('input-price-eur-' + id);
            const eur = eurInput ? parseFloat(eurInput.value) : NaN;
            if (!(eur > 0)) {
                alert('⚠️ Introduce un precio de venta valido');
                renderPortfolio();
                return;
            }
            pos.sellPrice = eur;
        }
        savePortfolioData();
        renderPortfolio();
        return;
    }

    const input = document.getElementById('input-price-current-' + id);
    const newPrice = input ? parseFloat(input.value) : NaN;
    if (!(newPrice > 0)) {
        alert('⚠️ Por favor, introduce un precio valido');
        renderPortfolio();
        return;
    }

    currentPrices[pos.ticker] = newPrice;
    manualPrices[pos.ticker] = newPrice;
    delete apiPrices[pos.ticker];
    delete apiErrors[pos.ticker];
    if (!maxPrices[pos.ticker] || newPrice > maxPrices[pos.ticker]) {
        maxPrices[pos.ticker] = newPrice;
        saveMaxPrices();
    }
    saveManualPrices();
    saveApiPrices();
    renderPortfolio();
}

