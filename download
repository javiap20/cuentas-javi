    // ===== VOZ =====
    let voiceRecognition = null;
    let activeMicBtn = null;

    function wordsToNumber(text) {
        const ones = { 'cero':0,'uno':1,'una':1,'dos':2,'tres':3,'cuatro':4,'cinco':5,'seis':6,'siete':7,'ocho':8,'nueve':9,
                       'diez':10,'once':11,'doce':12,'trece':13,'catorce':14,'quince':15,
                       'dieciséis':16,'diecisiete':17,'dieciocho':18,'diecinueve':19,
                       'veinte':20,'veintiuno':21,'veintidós':22,'veintitrés':23,'veinticuatro':24,
                       'veinticinco':25,'veintiséis':26,'veintisiete':27,'veintiocho':28,'veintinueve':29,
                       'treinta':30,'cuarenta':40,'cincuenta':50,'sesenta':60,'setenta':70,'ochenta':80,'noventa':90,
                       'cien':100,'ciento':100,'doscientos':200,'doscientas':200,'trescientos':300,'trescientas':300,
                       'cuatrocientos':400,'cuatrocientas':400,'quinientos':500,'quinientas':500,
                       'seiscientos':600,'seiscientas':600,'setecientos':700,'setecientas':700,
                       'ochocientos':800,'ochocientas':800,'novecientos':900,'novecientas':900,
                       'mil':1000,'millón':1000000,'millones':1000000 };

        text = text.toLowerCase().trim();
        // Separar parte entera y decimal por "con"
        let intPart = text, decPart = null;
        if (text.includes(' con ')) {
            const parts = text.split(' con ');
            intPart = parts[0].trim();
            decPart = parts[1].trim();
        }

        function parseInteger(t) {
            t = t.replace(/\by\b/g, '').replace(/\bde\b/g, '').trim();
            let total = 0, current = 0;
            const words = t.split(/\s+/);
            for (let w of words) {
                if (ones[w] !== undefined) {
                    if (w === 'mil') { total = (total + current || 1) * 1000; current = 0; }
                    else if (w === 'millón' || w === 'millones') { total = (total + current || 1) * 1000000; current = 0; }
                    else current += ones[w];
                }
            }
            return total + current;
        }

        let result = parseInteger(intPart);
        if (decPart !== null) {
            const decVal = parseInteger(decPart);
            const decStr = decVal.toString();
            result = parseFloat(result + '.' + decStr);
        }
        return isNaN(result) ? null : result;
    }

    function processVoiceResult(transcript, fieldId, fieldType) {
        const el = document.getElementById(fieldId);
        if (!el) return;
        let value = transcript.trim();

        if (fieldType === 'number') {
            // Intentar primero como número directo
            const direct = parseFloat(value.replace(',', '.'));
            if (!isNaN(direct)) {
                el.value = direct;
            } else {
                const num = wordsToNumber(value);
                if (num !== null) el.value = num;
                else el.value = value;
            }
        } else if (fieldType === 'ticker') {
            // Letras sueltas => juntar (p.e. "P L T R" => "PLTR")
            value = value.toUpperCase().replace(/\s+/g, '');
            el.value = value;
        } else if (fieldType === 'currency') {
            if (/euro/i.test(value)) setAddCurrency('EUR');
            else if (/d[oó]lar/i.test(value)) setAddCurrency('USD');
        } else if (fieldType === 'type') {
            if (/acci[oó]n|stock/i.test(value)) setAddType('stock');
            else if (/crypto|cripto/i.test(value)) setAddType('crypto');
        } else {
            el.value = value;
        }
    }

    function startVoice(fieldId, fieldType) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) {
            alert('Tu navegador no soporta reconocimiento de voz. Prueba con Safari (iOS) o Chrome.');
            return;
        }

        // Si ya hay uno activo, pararlo
        if (voiceRecognition) {
            voiceRecognition.stop();
            voiceRecognition = null;
        }
        if (activeMicBtn) {
            activeMicBtn.classList.remove('recording');
            activeMicBtn.textContent = '🎤';
        }

        // Buscar el botón activo
        const allMics = document.querySelectorAll('.btn-mic');
        activeMicBtn = null;
        allMics.forEach(btn => {
            if (btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(fieldId)) {
                activeMicBtn = btn;
            }
        });

        const hint = document.getElementById('voiceHint');
        if (hint) { hint.classList.add('active'); }
        if (activeMicBtn) { activeMicBtn.classList.add('recording'); activeMicBtn.textContent = '🔴'; }

        voiceRecognition = new SpeechRecognition();
        voiceRecognition.lang = 'es-ES';
        voiceRecognition.interimResults = false;
        voiceRecognition.maxAlternatives = 1;

        voiceRecognition.onresult = function(event) {
            const transcript = event.results[0][0].transcript;
            processVoiceResult(transcript, fieldId, fieldType);
        };

        voiceRecognition.onerror = function(event) {
            console.log('Voice error:', event.error);
        };

        voiceRecognition.onend = function() {
            if (hint) hint.classList.remove('active');
            if (activeMicBtn) { activeMicBtn.classList.remove('recording'); activeMicBtn.textContent = '🎤'; }
            voiceRecognition = null;
            activeMicBtn = null;
        };

        voiceRecognition.start();
    }
    // ===== FIN VOZ =====

