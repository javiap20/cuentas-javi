function confirmAddPosition() {
    const year = parseInt(document.getElementById('addYear').value);
    const ticker = document.getElementById('addTicker').value.trim().toUpperCase();
    const name = document.getElementById('addName').value.trim();
    const quantity = parseFloat(document.getElementById('addQuantity').value);
    const type = document.getElementById('addType').value;
    const exchange = document.getElementById('addExchange').value;
    const isin = document.getElementById('addIsin').value.trim().toUpperCase();
    const isSold = document.getElementById('addIsSold').checked;
    const currency = document.getElementById('addCurrency').value;
    const positionBucket = document.getElementById('addPositionBucket').value;

    if (!year || year < 2010 || year > 2030) { alert('⚠️ Por favor, introduce un año válido (2010-2030)'); return; }
    if (!ticker) { alert('⚠️ Por favor, introduce un ticker'); return; }
    if (!name) { alert('⚠️ Por favor, introduce el nombre'); return; }
    if (!quantity || quantity <= 0) { alert('⚠️ Por favor, introduce una cantidad válida'); return; }
    if (!isSold && !['trading', 'cartera'].includes(positionBucket)) { alert('⚠️ Elige si la nueva posición es Trading o Cartera'); return; }
    if (isin && !/^[A-Z]{2}[A-Z0-9]{9}[0-9]$/.test(isin)) { alert('⚠️ El ISIN no tiene un formato válido (2 letras de país + 10 caracteres, ej: US0378331005). Puedes dejarlo vacío si no lo tienes a mano.'); return; }

    const newPosition = {
        id: 'pos_' + Date.now() + '_' + Math.random().toString(36).substr(2,5),
        ticker, name, quantity, type, currency,
        exchange: type === 'stock' ? exchange : undefined,
        isin: isin || undefined,
        sold: false
    };
    if (!isSold) newPosition.positionBucket = positionBucket;

    if (currency === 'EUR') {
        const buyPrice = parseFloat(document.getElementById('addBuyPriceEUR').value);
        if (!buyPrice || buyPrice <= 0) { alert('⚠️ Por favor, introduce el precio de compra en €'); return; }
        newPosition.buyPrice = buyPrice;
    } else {
        const buyPriceUSD = parseFloat(document.getElementById('addBuyPriceUSD').value);
        const buyPriceEUR = parseFloat(document.getElementById('addBuyPriceEUR').value);
        if (!buyPriceUSD || buyPriceUSD <= 0) { alert('⚠️ Por favor, introduce el precio de compra en $'); return; }
        if (!buyPriceEUR || buyPriceEUR <= 0) { alert('⚠️ Por favor, introduce el precio equivalente en €'); return; }
        newPosition.buyPriceUSD = buyPriceUSD;
        newPosition.buyPriceEUR = buyPriceEUR;
    }

    if (isSold) {
        const sellYear = parseInt(document.getElementById('addSellYear').value);
        if (!sellYear || sellYear < 2010 || sellYear > 2040) { alert('⚠️ Por favor, introduce un año de venta válido'); return; }
        newPosition.sold = true;
        newPosition.sellYear = sellYear;
        if (currency === 'EUR') {
            const sellPrice = parseFloat(document.getElementById('addSellPriceEUR').value);
            if (!sellPrice || sellPrice <= 0) { alert('⚠️ Por favor, introduce el precio de venta en €'); return; }
            newPosition.sellPrice = sellPrice;
        } else {
            const sellPriceUSD = parseFloat(document.getElementById('addSellPriceUSD').value);
            const sellPriceEUR = parseFloat(document.getElementById('addSellPriceEURfromUSD').value);
            if (!sellPriceUSD || sellPriceUSD <= 0) { alert('⚠️ Por favor, introduce el precio de venta en $'); return; }
            if (!sellPriceEUR || sellPriceEUR <= 0) { alert('⚠️ Por favor, introduce el precio de venta equivalente en €'); return; }
            newPosition.sellPriceUSD = sellPriceUSD;
            newPosition.sellPriceEUR = sellPriceEUR;
        }
    }

    if (!portfolioData[String(year)]) portfolioData[String(year)] = { positions: [] };
    portfolioData[String(year)].positions.push(newPosition);
    savePortfolioData();
    closeAddPositionModal();
    if (newPosition.sold) {
        switchYear(year);
    } else {
        activePortfolioFilter = 'activa';
        switchYear('ACTIVA');
    }
    alert('✅ Posición añadida correctamente a ' + year);
}

function deletePosition(id, year) {
    const pos = portfolioData[year].positions.find(p => p.id === id);
    if (!pos) return;
    if (!confirm('⚠️ ¿Estás seguro de eliminar la posición ' + pos.ticker + ' del año ' + year + '?\n\nEsta acción no se puede deshacer.')) return;
    portfolioData[year].positions = portfolioData[year].positions.filter(p => p.id !== id);
    if (portfolioData[year].positions.length === 0) {
        delete portfolioData[year];
    }
    savePortfolioData();
    renderYearSelector();
    if (portfolioData[currentYear]) {
        renderPortfolio();
    } else {
        const years = Object.keys(portfolioData).sort().reverse();
        if (years.length > 0) {
            switchYear(parseInt(years[0]));
        }
    }
}



