    document.getElementById('editBuyPriceUSD').value = isUSD ? (pos.buyPriceUSD || '') : '';
    document.getElementById('editBuyPriceEUR').value = isUSD ? (pos.buyPriceEUR || '') : (pos.buyPrice || '');
