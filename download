function setTargetPriceFromInfo(ticker, value, id, year) {
    const v = parseFloat(value);
    if (!isNaN(v) && v > 0) targetPrices[ticker] = v;
    else delete targetPrices[ticker];
    saveTargetPrices();
    renderPortfolio();
