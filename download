<script>
let currentYear = 2026;
let currentPrices = {};
let manualPrices = {};
let apiPrices = {};
let apiErrors = {}; // ticker -> { msg, rateLimited } — se resetea al recargar la página
let targetPrices = {};
let stopLossPrices = {};
let supportResistance = {};
let usdToEur = 0.92;
let portfolioData = {};
let currentSellTicker = null;
let currentSellBuyYear = null; // año donde está guardada la posición a vender
let currentEditYear = null; // año donde está guardada la posición a editar
let activePortfolioFilter = 'activa'; // activa | trading | cartera. No clasifica posiciones antiguas automáticamente.

function initializeDefaultData() {
    const saved = localStorage.getItem('portfolioData');
    if (!saved) {
        portfolioData = {};
        savePortfolioData();
    } else {
        // Normalizar claves a string por si hay datos corruptos de versiones anteriores
        const raw = JSON.parse(saved);
        portfolioData = {};
        Object.keys(raw).forEach(k => {
            portfolioData[String(k)] = raw[k];
            // Asignar id a posiciones antiguas que no lo tengan
            if (portfolioData[String(k)].positions) {
                portfolioData[String(k)].positions.forEach(p => {
                    if (!p.id) p.id = 'pos_' + Date.now() + '_' + Math.random().toString(36).substr(2,5);
                });
            }
        });
    }
}

function savePortfolioData() {
    localStorage.setItem('portfolioData', JSON.stringify(portfolioData));
    // Auto-guardar en Gist con debounce de 2s para no saturar la API
    if (gistConfigurado()) {
        clearTimeout(window._gistSaveTimer);
        window._gistSaveTimer = setTimeout(function() { guardarEnGist(false); }, 2000);
    }
}
function loadManualPrices() { const saved = localStorage.getItem('manualPrices'); if (saved) { manualPrices = JSON.parse(saved); Object.keys(manualPrices).forEach(ticker => { currentPrices[ticker] = manualPrices[ticker]; }); } const savedApi = localStorage.getItem('apiPrices'); if (savedApi) { apiPrices = JSON.parse(savedApi); Object.keys(apiPrices).forEach(ticker => { currentPrices[ticker] = apiPrices[ticker]; }); } }
function saveStopLossPrices() { localStorage.setItem('stopLossPrices', JSON.stringify(stopLossPrices)); }
function loadStopLossPrices() { const s = localStorage.getItem('stopLossPrices'); if (s) stopLossPrices = JSON.parse(s); }
function setStopLoss(ticker, value) {
    const v = parseFloat(value);
    if (!isNaN(v) && v > 0) { stopLossPrices[ticker] = v; } else { delete stopLossPrices[ticker]; }
    saveStopLossPrices();
    renderPortfolio();
}
function stopLossCell(item) {
    if (item.sold) return '<td></td>';
    const isUSD = item.currency === 'USD';
    const currentRaw = currentPrices[item.ticker] || (isUSD ? item.buyPriceUSD : item.buyPrice);
    const buyPrice = isUSD ? item.buyPriceUSD : item.buyPrice;
    const symbol = isUSD ? '$' : '€';
    const profitPct = ((currentRaw - buyPrice) / buyPrice) * 100;

    let stop, stopLabel;
    if (profitPct >= 10) {
        // Trailing: -5% del máximo histórico
        const trailMax = maxPrices[item.ticker] || currentRaw;
        stop = trailMax * 0.95;
        stopLabel = '-5% del máx. (' + symbol + formatNumber(trailMax, 2) + ')';
    } else {
        // Fijo: -3,5% del precio de compra
        stop = buyPrice * 0.965;
        stopLabel = '-3,5% de compra';
    }

    const triggered = currentRaw <= stop;
    const priceColor = triggered ? '#ef4444' : '#3b82f6';
    return '<td class="target-price-cell" style="text-align:center;">'
        + '<span style="font-weight:bold;color:' + priceColor + ';">' + symbol + formatNumber(stop, 2) + '</span>'
        + '<span class="stop-distance" style="color:#94a3b8;">' + stopLabel + '</span>'
        + '</td>';
}

function isStopTriggered(item) {
    if (item.sold) return false;
    const isUSD = item.currency === 'USD';
    const currentRaw = currentPrices[item.ticker] || (isUSD ? item.buyPriceUSD : item.buyPrice);
    const buyPrice = isUSD ? item.buyPriceUSD : item.buyPrice;
    const profitPct = ((currentRaw - buyPrice) / buyPrice) * 100;
    if (profitPct >= 10) {
        const trailMax = maxPrices[item.ticker] || currentRaw;
        return currentRaw <= trailMax * 0.95;
    }
    return currentRaw <= buyPrice * 0.965;
}
function checkTargetAlerts() {
    const banner = document.getElementById('targetAlertBanner');
    const list = document.getElementById('targetAlertList');
    if (!banner || !list) return;
    if (currentYear !== 'ACTIVA') { banner.style.display = 'none'; return; }
    const alerts = [];
    getOpenPositions().forEach(item => {
        const isUSD = item.currency === 'USD';
        const currentRaw = currentPrices[item.ticker] || (isUSD ? item.buyPriceUSD : item.buyPrice);
        const buyPrice = isUSD ? item.buyPriceUSD : item.buyPrice;
        const target = targetPrices[item.ticker] || buyPrice * 1.20;
        const symbol = isUSD ? '$' : '€';
        if (currentRaw >= target) {
            const pct = ((currentRaw - buyPrice) / buyPrice * 100).toFixed(2);
            alerts.push(item.ticker + ' (' + item.name + ') — Actual: ' + symbol + formatNumber(currentRaw, 2) + ' / Objetivo: ' + symbol + formatNumber(target, 2) + ' (+' + pct + '%)');
        }
    });
    if (alerts.length > 0) {
        list.innerHTML = alerts.map(a => '<li>' + a + '</li>').join('');
        banner.style.display = 'block';
    } else {
        banner.style.display = 'none';
    }
}
function checkStopAlerts() {
    const banner = document.getElementById('stopAlertBanner');
    const list = document.getElementById('stopAlertList');
    if (!banner || !list) return;
    if (currentYear !== 'ACTIVA') { banner.style.display = 'none'; return; }
    const alerts = [];
    getOpenPositions().forEach(item => {
        const isUSD = item.currency === 'USD';
        const currentRaw = currentPrices[item.ticker] || (isUSD ? item.buyPriceUSD : item.buyPrice);
        const buyPrice = isUSD ? item.buyPriceUSD : item.buyPrice;
        const symbol = isUSD ? '$' : '€';
        const profitPct = ((currentRaw - buyPrice) / buyPrice) * 100;
        let stop;
        if (profitPct >= 10) {
            const trailMax = maxPrices[item.ticker] || currentRaw;
            stop = trailMax * 0.95;
        } else {
            stop = buyPrice * 0.965;
        }
        if (currentRaw && currentRaw <= stop) {
            alerts.push(item.ticker + ' (' + item.name + ') — Actual: ' + symbol + formatNumber(currentRaw, 2) + ' / Stop: ' + symbol + formatNumber(stop, 2));
        }
    });
    if (alerts.length > 0) {
        list.innerHTML = alerts.map(a => '<li>' + a + '</li>').join('');
        banner.style.display = 'block';
    } else {
        banner.style.display = 'none';
    }
}
function saveTargetPrices() { localStorage.setItem('targetPrices', JSON.stringify(targetPrices)); }
function loadTargetPrices() { const s = localStorage.getItem('targetPrices'); if (s) targetPrices = JSON.parse(s); }
function setTargetPrice(ticker, value) {
    const v = parseFloat(value);
    if (!isNaN(v) && v > 0) { targetPrices[ticker] = v; } else { delete targetPrices[ticker]; }
    saveTargetPrices();
    renderPortfolio();
}
function saveManualPrices() { localStorage.setItem('manualPrices', JSON.stringify(manualPrices)); }
function saveApiPrices() { localStorage.setItem('apiPrices', JSON.stringify(apiPrices)); }
function formatEUR0(amount) { return Math.round(amount).toLocaleString('es-ES', { useGrouping: true }) + ' €'; }
function formatUSD0(amount) { return '$' + Math.round(amount).toLocaleString('es-ES', { useGrouping: true }); }
function formatNumber(num, decimals = 2) { return num.toLocaleString('es-ES', { minimumFractionDigits: decimals, maximumFractionDigits: decimals, useGrouping: true }); }

// Helper: devuelve todas las posiciones abiertas de todos los años
function getOpenPositions() {
    const open = [];
    Object.keys(portfolioData).sort().forEach(year => {
        const yd = portfolioData[year];
        if (!yd || !yd.positions) return;
        yd.positions.forEach(p => {
            if (!p.sold) open.push(Object.assign({}, p, { _buyYear: year }));
        });
    });
    return open;
}
function formatUSD(amount) { return '\$' + formatNumber(amount, 2); }
function formatEUR(amount) { return formatNumber(amount, 2) + ' €'; }
function toggleApiConfig() { document.getElementById('apiConfig').classList.toggle('show'); }
function saveApiKey() { const apiKey = document.getElementById('apiKeyInput').value.trim(); const statusDiv = document.getElementById('apiStatus'); if (!apiKey) { statusDiv.className = 'api-status error'; statusDiv.textContent = '❌ Por favor, introduce una API Key válida'; return; } localStorage.setItem('alphaVantageApiKey', apiKey); statusDiv.className = 'api-status success'; statusDiv.textContent = '✅ API Key guardada correctamente'; document.getElementById('apiKeyInput').value = ''; }
function loadApiKey() { const savedKey = localStorage.getItem('alphaVantageApiKey'); if (savedKey) { const statusDiv = document.getElementById('apiStatus'); statusDiv.className = 'api-status success'; statusDiv.textContent = '✅ API Key configurada'; } }
function saveFinnhubKey() { const apiKey = document.getElementById('finnhubKeyInput').value.trim(); const statusDiv = document.getElementById('finnhubStatus'); if (!apiKey) { statusDiv.className = 'api-status error'; statusDiv.textContent = '❌ Por favor, introduce una API Key válida'; return; } localStorage.setItem('finnhubApiKey', apiKey); statusDiv.className = 'api-status success'; statusDiv.textContent = '✅ API Key guardada correctamente'; document.getElementById('finnhubKeyInput').value = ''; }
function loadFinnhubKey() { const savedKey = localStorage.getItem('finnhubApiKey'); if (savedKey) { const statusDiv = document.getElementById('finnhubStatus'); statusDiv.className = 'api-status success'; statusDiv.textContent = '✅ API Key configurada'; } }

function setActivePortfolioFilter(filter) {
    if (!['activa', 'trading', 'cartera'].includes(filter)) return;
    activePortfolioFilter = filter;
    updateActivePortfolioFilterUI();
    if (currentYear === 'ACTIVA') renderPortfolio();
}

function updateActivePortfolioFilterUI() {
    const bar = document.getElementById('activePortfolioFilter');
    if (!bar) return;
    bar.style.display = currentYear === 'ACTIVA' ? 'flex' : 'none';
    bar.querySelectorAll('.active-filter-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.filter === activePortfolioFilter);
    });
}

function updateSummaryTitlesForView() {
    const stocksTitle = document.getElementById('stocksSummaryTitle');
    const totalTitle = document.getElementById('totalSummaryTitle');
    if (!stocksTitle || !totalTitle) return;
    if (currentYear === 'ACTIVA' && activePortfolioFilter === 'trading') {
        stocksTitle.textContent = '📊 Acciones Trading';
        totalTitle.textContent = '📊 Total Trading (Acciones + Cripto)';
    } else if (currentYear === 'ACTIVA' && activePortfolioFilter === 'cartera') {
        stocksTitle.textContent = '💼 Acciones Cartera';
        totalTitle.textContent = '💼 Total Cartera (Acciones + Cripto)';
    } else {
        stocksTitle.textContent = '📈 Solo Acciones';
        totalTitle.textContent = '🌍 Total (Acciones + Cripto)';
    }
}

function setPositionBucket(id, year, bucket) {
    if (!['trading', 'cartera'].includes(bucket)) return;
    const yd = portfolioData[String(year)];
    if (!yd || !yd.positions) return;
    const pos = yd.positions.find(p => p.id === id);
    if (!pos || pos.sold) return;

    // Pulsar de nuevo la opción activa permite volver temporalmente a "Sin clasificar".
    if (pos.positionBucket === bucket) delete pos.positionBucket;
    else pos.positionBucket = bucket;

    savePortfolioData();
    renderPortfolio();
}

function positionBucketCell(item) {
    if (item.sold) return '<span style="color:#94a3b8;">—</span>';
    const bucket = item.positionBucket || '';
    const yr = String(item._buyYear);
    const state = bucket === 'trading' ? 'Trading' : (bucket === 'cartera' ? 'Cartera' : 'Sin clasificar');
    return '<div class="position-bucket-wrap">'
        + '<div class="position-bucket-control">'
        + '<button type="button" class="position-bucket-btn trading ' + (bucket === 'trading' ? 'active' : '') + '" title="Marcar como Trading" onclick="event.stopPropagation();setPositionBucket(\'' + item.id + '\',\'' + yr + '\',\'trading\')">Trading</button>'
        + '<button type="button" class="position-bucket-btn cartera ' + (bucket === 'cartera' ? 'active' : '') + '" title="Marcar como Cartera" onclick="event.stopPropagation();setPositionBucket(\'' + item.id + '\',\'' + yr + '\',\'cartera\')">Cartera</button>'
        + '</div>'
        + '<span class="position-bucket-state ' + (bucket ? 'assigned' : '') + '">' + state + '</span>'
        + '</div>';
}

function setAddCurrency(currency) {
    if (!['EUR', 'USD'].includes(currency)) return;
    const input = document.getElementById('addCurrency');
    if (input) input.value = currency;
    const eurBtn = document.getElementById('addCurrencyEUR');
    const usdBtn = document.getElementById('addCurrencyUSD');
    if (eurBtn) eurBtn.classList.toggle('active', currency === 'EUR');
    if (usdBtn) usdBtn.classList.toggle('active', currency === 'USD');
