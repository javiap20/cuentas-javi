}

function openPositionInfoModal(id, year) {
    const yd = portfolioData[String(year)];
    if (!yd || !yd.positions) return;
    const item = yd.positions.find(p => p.id === id);
    if (!item || item.sold) return;

    const modal = document.getElementById('positionInfoModal');
    const title = document.getElementById('positionInfoTitle');
    const subtitle = document.getElementById('positionInfoSubtitle');
    const content = document.getElementById('positionInfoContent');
    if (!modal || !title || !subtitle || !content) return;

    const isUSD = item.currency === 'USD';
    const symbol = isUSD ? '$' : '\u20ac';
    const buyPrice = isUSD ? item.buyPriceUSD : item.buyPrice;
    const currentRaw = currentPrices[item.ticker] || buyPrice;
    const profitPct = buyPrice > 0 ? ((currentRaw - buyPrice) / buyPrice) * 100 : 0;

    let stop, stopLabel;
    if (profitPct >= 10) {
        const trailMax = maxPrices[item.ticker] || currentRaw;
        stop = trailMax * 0.95;
        stopLabel = '-5% del m\u00e1ximo (' + symbol + formatNumber(trailMax, 2) + ')';
    } else {
        stop = buyPrice * 0.965;
        stopLabel = '-3,5% del precio de compra';
    }
    const stopTriggered = currentRaw <= stop;
    const stopDistance = currentRaw > 0 ? ((stop - currentRaw) / currentRaw) * 100 : 0;

    const target = targetPrices[item.ticker] || buyPrice * 1.20;
    const targetReached = currentRaw >= target;
    const targetDistance = currentRaw > 0 ? ((target - currentRaw) / currentRaw) * 100 : 0;

    const quantity = Number(item.quantity) || 0;
    const rawToEUR = isUSD ? usdToEur : 1;
    const riskPerUnit = Math.max(currentRaw - stop, 0);
    const rewardPerUnit = Math.max(target - currentRaw, 0);
    const riskPct = currentRaw > 0 ? (riskPerUnit / currentRaw) * 100 : 0;
    const rewardPct = currentRaw > 0 ? (rewardPerUnit / currentRaw) * 100 : 0;
    const riskEUR = riskPerUnit * quantity * rawToEUR;
    const rewardEUR = rewardPerUnit * quantity * rawToEUR;
    const riskRewardRatio = (!stopTriggered && !targetReached && riskEUR > 0) ? rewardEUR / riskEUR : null;
    const riskText = stopTriggered
        ? '<strong class="metric-danger">STOP CRUZADO</strong>'
        : '<strong class="metric-danger">-' + formatNumber(riskPct, 1) + '% \u00b7 -' + formatEUR(riskEUR) + '</strong>';
    const rewardText = targetReached
        ? '<strong class="metric-good">OBJETIVO ALCANZADO</strong>'
        : '<strong class="metric-good">+' + formatNumber(rewardPct, 1) + '% \u00b7 +' + formatEUR(rewardEUR) + '</strong>';
    const ratioText = riskRewardRatio !== null && Number.isFinite(riskRewardRatio)
        ? '1 : ' + formatNumber(riskRewardRatio, 2)
        : '\u2014';

    const openAll = getOpenPositions();
    const valueEUR = p => {
        const pIsUSD = p.currency === 'USD';
        const pBuy = pIsUSD ? p.buyPriceUSD : p.buyPrice;
        const pCurrent = currentPrices[p.ticker] || pBuy || 0;
        return (Number(p.quantity) || 0) * pCurrent * (pIsUSD ? usdToEur : 1);
    };
    const itemValueEUR = quantity * currentRaw * rawToEUR;
    const activeTotalEUR = openAll.reduce((sum, p) => sum + valueEUR(p), 0);
    const activeWeight = activeTotalEUR > 0 ? itemValueEUR / activeTotalEUR * 100 : 0;
    const bucket = item.positionBucket || '';
    const bucketLabel = bucket === 'trading' ? 'Trading' : (bucket === 'cartera' ? 'Cartera' : '');
    const bucketTotalEUR = bucket
        ? openAll.filter(p => p.positionBucket === bucket).reduce((sum, p) => sum + valueEUR(p), 0)
        : 0;
    const bucketWeight = bucketTotalEUR > 0 ? itemValueEUR / bucketTotalEUR * 100 : 0;

    const recordedMax = Number(maxPrices[item.ticker]) || 0;
    let drawdownMain = '\u2014';
    let drawdownDetail = 'Sin m\u00e1ximo registrado';
    let drawdownClass = '';
    if (recordedMax > 0) {
        const effectiveMax = Math.max(recordedMax, currentRaw);
        const drawdownPct = effectiveMax > 0 ? (currentRaw - effectiveMax) / effectiveMax * 100 : 0;
        drawdownMain = (drawdownPct > 0 ? '+' : '') + formatNumber(drawdownPct, 1) + '%';
        drawdownDetail = 'M\u00e1ximo: ' + symbol + formatNumber(effectiveMax, 2);
        drawdownClass = drawdownPct <= -10 ? 'metric-danger' : (drawdownPct <= -5 ? 'metric-warn' : 'metric-good');
    }

    let signalClass = 'yellow';
    let signalIcon = '\ud83d\udfe1';
    let signalLabel = 'ZONA INTERMEDIA';
    let signalDetail = 'Equilibrio entre stop y objetivo';
    if (stopTriggered) {
        signalClass = 'red';
        signalIcon = '\ud83d\udd34';
        signalLabel = 'STOP CRUZADO';
        signalDetail = 'El precio actual est\u00e1 en o por debajo del stop';
    } else if (targetReached) {
        signalClass = 'green';
        signalIcon = '\ud83d\udfe2';
        signalLabel = 'OBJETIVO ALCANZADO';
        signalDetail = 'El precio actual ha alcanzado o superado el objetivo';
    } else if (target > stop) {
        const progress = (currentRaw - stop) / (target - stop);
        const progressPct = Math.max(0, Math.min(1, progress)) * 100;
        if (progress >= 0.75) {
            signalClass = 'green';
            signalIcon = '\ud83d\udfe2';
            signalLabel = 'CERCA DE OBJETIVO';
        } else if (progress <= 0.25) {
            signalClass = 'red';
            signalIcon = '\ud83d\udd34';
            signalLabel = 'CERCA DEL STOP';
        }
        signalDetail = 'Recorrido stop \u2192 objetivo: ' + formatNumber(progressPct, 0) + '%';
    }

    let supportHtml = '<div class="position-info-main" style="color:#94a3b8;">N/A</div>';
    let resistanceHtml = '<div class="position-info-main" style="color:#94a3b8;">N/A</div>';
    if (item.type === 'stock') {
        const sr = supportResistance[item.ticker];
        if (sr) {
            supportHtml = '<div class="position-info-line"><span>S1</span><strong>' + formatUSD(sr.support1) + '</strong></div>'
                + '<div class="position-info-line"><span>S2</span><strong>' + formatUSD(sr.support2) + '</strong></div>';
            resistanceHtml = '<div class="position-info-line"><span>R1</span><strong>' + formatUSD(sr.resistance1) + '</strong></div>'
                + '<div class="position-info-line"><span>R2</span><strong>' + formatUSD(sr.resistance2) + '</strong></div>';
        } else {
            supportHtml = '<div class="position-info-main" style="color:#94a3b8;">\u2014</div><div class="position-info-line"><span>Actualiza precios para calcularlos</span></div>';
            resistanceHtml = '<div class="position-info-main" style="color:#94a3b8;">\u2014</div><div class="position-info-line"><span>Actualiza precios para calcularlos</span></div>';
        }
    }

    const targetValue = Number.isFinite(target) ? target.toFixed(2) : '';
    const stopStatus = stopTriggered ? '\ud83d\udea8 Stop cruzado' : formatNumber(Math.abs(stopDistance), 1) + '% hasta el stop';
    const targetStatus = targetReached ? '\ud83c\udfaf Objetivo alcanzado' : '+' + formatNumber(Math.max(targetDistance, 0), 1) + '% para objetivo';
    const googleUrl = 'https://www.google.com/search?q=' + encodeURIComponent(item.ticker + ' stock news');
    const yahooUrl = 'https://finance.yahoo.com/quote/' + encodeURIComponent(item.ticker) + '/news/';

    title.textContent = '\ud83d\udd0e ' + item.ticker + ' \u2014 ' + item.name;
    subtitle.textContent = 'Compra ' + year + ' \u00b7 Precio actual: ' + symbol + formatNumber(currentRaw, 2) + ' \u00b7 G/P: ' + (profitPct >= 0 ? '+' : '') + formatNumber(profitPct, 2) + '%';

    const weightBucketLine = bucketLabel
        ? '<div class="position-info-metric-line"><span>Dentro de ' + bucketLabel + '</span><strong>' + formatNumber(bucketWeight, 1) + '%</strong></div>'
        : '<div class="position-info-metric-line"><span>Clasificaci\u00f3n</span><strong>Sin clasificar</strong></div>';

    content.innerHTML = `
        <div class="position-info-signal ${signalClass}">
            <strong>${signalIcon} ${signalLabel}</strong><span>${signalDetail}</span>
        </div>
        <div class="position-info-insights">
            <div class="position-info-insight">
                <h4>RIESGO / OBJETIVO</h4>
                <div class="position-info-metric-line"><span>\ud83d\uded1 Hasta Stop</span>${riskText}</div>
                <div class="position-info-metric-line"><span>\ud83c\udfaf Hasta Objetivo</span>${rewardText}</div>
                <div class="position-info-metric-line"><span>\u2696\ufe0f Ratio R/B</span><strong>${ratioText}</strong></div>
                <div class="position-info-metric-note">Desde el precio actual${isUSD ? ' \u00b7 importes convertidos a EUR al cambio actual' : ''}</div>
            </div>
            <div class="position-info-insight">
                <h4>PESO</h4>
                <div class="position-info-metric-main">${formatNumber(activeWeight, 1)}%</div>
                <div class="position-info-metric-line"><span>Cartera activa</span><strong>${formatEUR(itemValueEUR)}</strong></div>
                ${weightBucketLine}
            </div>
            <div class="position-info-insight">
                <h4>DRAWDOWN DESDE M\u00c1XIMO</h4>
                <div class="position-info-metric-main ${drawdownClass}">${drawdownMain}</div>
                <div class="position-info-metric-line"><span>${drawdownDetail}</span></div>
                <div class="position-info-metric-note">Usa el m\u00e1ximo registrado para el trailing stop</div>
            </div>
        </div>
        <div class="position-info-section-title">NIVELES T\u00c9CNICOS</div>
        <div class="position-info-grid">
            <div class="position-info-card"><h4>\ud83e\uddf1 Soporte</h4>${supportHtml}</div>
            <div class="position-info-card"><h4>\ud83d\udd3a Resistencia</h4>${resistanceHtml}</div>
            <div class="position-info-card position-info-stop${stopTriggered ? ' triggered' : ''}">
                <h4>\ud83d\uded1 Stop Loss</h4>
                <div class="position-info-main">${symbol}${formatNumber(stop, 2)}</div>
                <div class="position-info-line"><span>${stopLabel}</span></div>
                <div class="position-info-line"><span>Estado</span><strong>${stopStatus}</strong></div>
            </div>
            <div class="position-info-card position-info-target${targetReached ? ' reached' : ''}">
                <h4>\ud83c\udfaf Objetivo</h4>
                <div class="position-info-target-input"><span style="font-weight:800;color:#64748b;">${symbol}</span>
                <input type="number" step="0.01" value="${targetValue}" onchange="setTargetPriceFromInfo('${item.ticker}', this.value, '${item.id}', '${year}')"></div>
                <div class="position-info-line"><span>Estado</span><strong>${targetStatus}</strong></div>
            </div>
        </div>
        <div class="position-info-news"><h4>\ud83d\udcf0 Noticias</h4><div class="position-info-news-links">
            <a href="${googleUrl}" target="_blank" class="btn-news">\ud83d\udcf0 Google</a>
            <a href="${yahooUrl}" target="_blank" class="btn-news btn-news-yahoo">\ud83d\udcca Yahoo</a>
        </div></div>`;

    modal.classList.add('show');
}

function renderPortfolio() {
    updateActivePortfolioFilterUI();
    updateSummaryTitlesForView();
    const tbodyStocks = document.getElementById('portfolioTableStocks');
    const tbodyCrypto = document.getElementById('portfolioTableCrypto');
    const tableBanner = document.getElementById('tableBanner');
    const stocksGroupWrapper = document.getElementById('stocksGroupWrapper');
    const cryptoGroupWrapper = document.getElementById('cryptoGroupWrapper');
    const stocksSectionTitle = document.getElementById('stocksSectionTitle');
    const cryptoSectionTitle = document.getElementById('cryptoSectionTitle');
    tbodyStocks.innerHTML = '';
    tbodyCrypto.innerHTML = '';
    tableBanner.innerHTML = '';
    if (stocksSectionTitle) stocksSectionTitle.innerHTML = '';
    if (cryptoSectionTitle) cryptoSectionTitle.innerHTML = '';
    stocksGroupWrapper.style.display = 'block';
    cryptoGroupWrapper.style.display = 'block';

    // En posiciones abiertas, Soporte/Resistencia/Stop/Objetivo/Noticias se muestran
    // en una ventana emergente por posición para mantener la tabla mucho más compacta.
    const showActiveOnlyCols = (currentYear === 'ACTIVA');
    const activeHeader = '<th>Ticker / Empresa</th><th>Cantidad</th><th>Precio Compra</th><th>Precio Actual/Venta</th><th>Inversión (€)</th><th>Valor Actual (€)</th><th>G/P (€)</th><th>G/P (%)</th><th>Trading / Cartera</th><th>Acción</th>';
    const compactHeader = '<th>Ticker / Empresa</th><th>Cantidad</th><th>Precio Compra</th><th>Precio Actual/Venta</th><th>Inversión (€)</th><th>Valor Actual (€)</th><th>G/P (€)</th><th>G/P (%)</th><th style="width:120px;">Acción</th>';
    const headerHtml = showActiveOnlyCols ? activeHeader : compactHeader;
    document.getElementById('theadRowStocks').innerHTML = headerHtml;
    document.getElementById('theadRowCrypto').innerHTML = headerHtml;
    const normalWrapper = document.getElementById('normalTableWrapper');
    normalWrapper.classList.toggle('compact-view', !showActiveOnlyCols);
    normalWrapper.classList.toggle('active-slim', showActiveOnlyCols);
    let totalInvested = 0;
    let totalCurrent = 0;

    // Convierte cualquier posición a su valor en EUR
    function getEURValues(item) {
        const isUSD = item.currency === 'USD';
        const buyCosts = item.buyCosts || 0;
        const sellCosts = item.sellCosts || 0;
        const investedEUR = item.quantity * (isUSD ? item.buyPriceEUR : item.buyPrice) + buyCosts;
        let currentValueEUR;
        if (item.sold) {
            const spEUR = isUSD ? (item.sellPriceEUR || item.sellPrice) : item.sellPrice;
            currentValueEUR = item.quantity * spEUR - sellCosts;
        } else {
            if (isUSD) {
                const usdNow = currentPrices[item.ticker] || item.buyPriceUSD;
                currentValueEUR = item.quantity * usdNow * usdToEur;
            } else {
                currentValueEUR = item.quantity * (currentPrices[item.ticker] || item.buyPrice);
            }
        }
        return { investedEUR, currentValueEUR };
    }

    function fmtBuyPrice(item) {
        const costs = item.buyCosts > 0 ? '<span style="display:block;font-size:10px;color:#f59e0b;" title="Gastos de compra">+' + formatEUR(item.buyCosts) + ' gastos</span>' : '';
        if (item.currency === 'USD')
            return formatUSD(item.buyPriceUSD) + ' <span style="font-size:10px;color:#94a3b8;">(' + formatEUR(item.buyPriceEUR) + ')</span>' + costs;
        return formatEUR(item.buyPrice) + costs;
    }

    function fmtCurrentPrice(item) {
        if (item.sold) {
            const costs = item.sellCosts > 0 ? '<span style="display:block;font-size:10px;color:#f59e0b;" title="Gastos de venta">-' + formatEUR(item.sellCosts) + ' gastos</span>' : '';
            if (item.currency === 'USD')
                return formatUSD(item.sellPriceUSD || 0) + ' <span style="font-size:10px;color:#94a3b8;">(' + formatEUR(item.sellPriceEUR || 0) + ')</span>' + costs;
            return formatEUR(item.sellPrice) + costs;
        }
        if (item.currency === 'USD') {
            const usdNow = currentPrices[item.ticker] || item.buyPriceUSD;
            return formatUSD(usdNow) + ' <span style="font-size:10px;color:#94a3b8;">(' + formatEUR(usdNow * usdToEur) + ')</span>';
        }
        return formatEUR(currentPrices[item.ticker] || item.buyPrice);
    }


    // Porcentaje que debe moverse el precio ACTUAL para volver exactamente al precio de compra.
    // Se calcula en la moneda original de la posicion y no incluye comisiones.
    function toBuyPriceDistanceHtml(item) {
        if (item.sold) return '';
        const isUSD = item.currency === 'USD';
        const currentRaw = currentPrices[item.ticker] || (isUSD ? item.buyPriceUSD : item.buyPrice);
        const buyRaw = isUSD ? item.buyPriceUSD : item.buyPrice;
        if (!currentRaw || !buyRaw || currentRaw <= 0 || buyRaw <= 0) return '';

        const movePct = ((buyRaw / currentRaw) - 1) * 100;
        if (Math.abs(movePct) < 0.005) {
            return '<span class="to-buy-distance flat" title="El precio actual coincide con el precio de compra">● 0,00% a compra</span>';
        }
        if (movePct > 0) {
            return '<span class="to-buy-distance up" title="Subida necesaria desde el precio actual para volver al precio de compra (sin comisiones)">↗ +' + formatNumber(movePct, 2) + '% a compra</span>';
        }
        return '<span class="to-buy-distance down" title="Bajada necesaria desde el precio actual para volver al precio de compra (sin comisiones)">↘ -' + formatNumber(Math.abs(movePct), 2) + '% a compra</span>';
    }

    if (currentYear === 'ACTIVA') {
        document.getElementById('globalPanel').style.display = 'none';
        document.getElementById('normalTableWrapper').style.display = 'block';

        // Recoger posiciones abiertas de TODOS los años
        const allOpenStocks = [];
        const allOpenCrypto = [];
        Object.keys(portfolioData).sort().forEach(year => {
            const yd = portfolioData[year];
            if (!yd || !yd.positions) return;
            yd.positions.forEach(p => {
                if (!p.sold) {
                    // Añadir referencia al año de compra para mostrarlo
                    const enriched = Object.assign({}, p, { _buyYear: year });
                    if (p.type === 'stock') allOpenStocks.push(enriched);
                    else if (p.type === 'crypto') allOpenCrypto.push(enriched);
                }
            });
        });

        // Activa conserva exactamente la vista completa. Trading/Cartera filtran
        // tanto acciones como criptomonedas por la clasificación guardada en cada posición.
        const openStocksA = activePortfolioFilter === 'activa'
            ? allOpenStocks
            : allOpenStocks.filter(p => p.positionBucket === activePortfolioFilter);
        const openCryptoA = activePortfolioFilter === 'activa'
            ? allOpenCrypto
            : allOpenCrypto.filter(p => p.positionBucket === activePortfolioFilter);
        const unclassifiedPositions = allOpenStocks.concat(allOpenCrypto).filter(p => !p.positionBucket).length;

        if (openStocksA.length === 0 && openCryptoA.length === 0) {
            stocksGroupWrapper.style.display = 'none';
            cryptoGroupWrapper.style.display = 'none';
            const emptyMsg = activePortfolioFilter === 'trading'
                ? 'No hay posiciones abiertas clasificadas como Trading'
                : (activePortfolioFilter === 'cartera'
                    ? 'No hay posiciones abiertas clasificadas como Cartera'
                    : 'No hay posiciones abiertas en ningún año');
            tableBanner.innerHTML = '<div style="text-align:center;padding:40px;color:#718096;">' + emptyMsg + '</div>';
            updateSummary(0, 0, 0, 0);
            return;
        }

        // Banner informativo
        if (activePortfolioFilter === 'activa') {
