        clearAddPositionBucket();
    } else {
        const input = document.getElementById('addPositionBucket');
        if (!input || !input.value) setAddPositionBucket('trading');
    }
}

function renderYearSelector() {
    const selector = document.getElementById('yearSelector');
    const years = Object.keys(portfolioData).sort().reverse();
    selector.innerHTML = '';

    // Botón ⚡ Activa — aparece si hay posiciones abiertas en CUALQUIER año
    const hasOpenAnywhere = years.some(y =>
        portfolioData[y] && portfolioData[y].positions && portfolioData[y].positions.some(p => !p.sold)
    );
    if (hasOpenAnywhere) {
        const activaTab = document.createElement('div');
        activaTab.className = 'year-tab year-tab-activa' + (currentYear === 'ACTIVA' ? ' active' : '');
        activaTab.innerHTML = '⚡ Activa';
        activaTab.title = 'Todas las posiciones abiertas — P&L latente puro';
        activaTab.onclick = () => switchYear('ACTIVA');
        selector.appendChild(activaTab);
    }

    // Tabs de año: solo si tienen posiciones CERRADAS
    years.forEach(year => {
        const hasClosed = portfolioData[year] && portfolioData[year].positions
            && portfolioData[year].positions.some(p => p.sold);
        if (!hasClosed) return; // no mostrar si no hay ninguna venta en ese año
        const tab = document.createElement('div');
        tab.className = 'year-tab' + (String(year) === String(currentYear) ? ' active' : '');
        tab.textContent = year;
        tab.onclick = () => switchYear(parseInt(year));
        selector.appendChild(tab);
    });

    // Highlight global button
    const globalBtn = document.getElementById('globalBtn');
    if (globalBtn) globalBtn.className = 'btn-global' + (currentYear === 'GLOBAL' ? ' active' : '');
}

function switchYear(year) {
    currentYear = year;
    renderYearSelector();
    updateActivePortfolioFilterUI();
    renderPortfolio();
    const aiPanel = document.getElementById('aiPanel');
    if (aiPanel) aiPanel.style.display = (year === 'ACTIVA') ? 'block' : 'none';

    // Alertas de stop/objetivo: solo visibles en cartera activa
    const stopBanner = document.getElementById('stopAlertBanner');
    const targetBanner = document.getElementById('targetAlertBanner');
    if (year !== 'ACTIVA') {
        if (stopBanner) stopBanner.style.display = 'none';
        if (targetBanner) targetBanner.style.display = 'none';
    }
    const closeYearBtn = document.getElementById('closeYearBtn');
    const updateBtn = document.getElementById('updateBtn');
    if (year === 'ACTIVA') {
        closeYearBtn.style.display = 'none';
        updateBtn.style.display = 'inline-block';
    } else if (year === 'GLOBAL') {
        closeYearBtn.style.display = 'none';
        updateBtn.style.display = 'none';
    } else {
        // En la nueva lógica los años solo tienen cerradas, no hay que "cerrar" el año manualmente
        closeYearBtn.style.display = 'none';
        updateBtn.style.display = 'none'; // no tiene sentido actualizar precios de posiciones cerradas
    }
}

function closePositionInfoModal() {
