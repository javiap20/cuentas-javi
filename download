        } else {
            pos.sellPrice = parseFloat(document.getElementById('editSellPriceEUR').value);
            delete pos.sellPriceUSD; delete pos.sellPriceEUR;
        }
    } else {
        delete pos.sellPrice; delete pos.sellPriceUSD; delete pos.sellPriceEUR;
        delete pos.sellCosts; delete pos.sellYear; delete pos.sellDate;
    }

    savePortfolioData();
    closeEditModal();
    renderPortfolio();
    alert('✅ Posición actualizada correctamente');
