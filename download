// Badge de estado junto al precio: Manual / API / Error (con motivo en el tooltip)
function priceStatusBadge(ticker) {
    if (manualPrices[ticker]) return '<span style="font-size:10px;color:#856404;white-space:nowrap;">✏️ Manual</span>';
    if (apiErrors[ticker]) {
        const e = apiErrors[ticker];
        const label = e.rateLimited ? '⏳ Límite API' : '⚠️ Sin datos';
        return '<span title="' + e.msg.replace(/"/g, '&quot;') + '" style="font-size:10px;color:#dc2626;white-space:nowrap;cursor:help;">' + label + '</span>';
    }
    if (apiPrices[ticker]) return '<span style="font-size:10px;color:#0ea5e9;white-space:nowrap;">🔄 API</span>';
    return '';
}
