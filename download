    <title>Cartera Multi-Año</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 20px; min-height: 100vh; }
        .container { max-width: 95%; width: 100%; margin: 0 auto; background: white; border-radius: 20px; padding: 30px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); overflow-x: auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 26px; }
        .header h1 { color: #2d3748; font-size: 2.1em; }
        .header-buttons { display: flex; gap: 6px; }
        .btn-header { padding: 4px 12px; background: #334155; color: white; border: 1.5px solid #475569; border-radius: 6px; cursor: pointer; font-size: 11px; transition: all 0.3s; font-weight: bold; }
        .btn-header:hover { background: #475569; transform: translateY(-2px); }
        .subtitle { text-align: center; color: #718096; margin-bottom: 24px; font-size: 1em; }
        .api-config { display: none; background: #f7fafc; border: 2px dashed #cbd5e0; border-radius: 10px; padding: 20px; margin-bottom: 30px; }
        .api-config.show { display: block; }
        .api-config h3 { color: #2d3748; margin-bottom: 15px; }
        .api-input-group { display: flex; gap: 10px; margin-bottom: 10px; }
        .api-input-group input { flex: 1; padding: 12px; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 14px; }
        .api-input-group button { padding: 12px 24px; background: #1e293b; color: white; border: 2px solid #475569; border-radius: 8px; cursor: pointer; font-weight: bold; transition: all 0.3s; }
        .api-input-group button:hover { background: #334155; transform: translateY(-2px); }
        .api-help { font-size: 13px; color: #718096; margin-top: 10px; }
        .api-help a { color: #3b82f6; text-decoration: none; font-weight: bold; }
        .api-status { margin-top: 10px; padding: 10px; border-radius: 6px; font-size: 14px; display: none; }
        .api-status.success { background: #c6f6d5; color: #22543d; display: block; }
        .api-status.error { background: #fed7d7; color: #742a2a; display: block; }
        .year-selector { display: flex; justify-content: center; gap: 5px; margin-bottom: 22px; flex-wrap: wrap; }
        .year-tab { padding: 4px 11px; background: #e2e8f0; color: #475569; border: 1.5px solid #cbd5e0; border-radius: 6px; cursor: pointer; font-weight: bold; transition: all 0.3s; font-size: 11px; }
        .year-tab:hover { background: #cbd5e0; transform: translateY(-1px); }
        .year-tab.active { background: linear-gradient(135deg, #1e293b 0%, #334155 100%); color: white; border-color: #475569; }
        .year-tab-activa { background: linear-gradient(135deg, #dcfce7, #bbf7d0); color: #15803d; border-color: #22c55e; font-weight: 800; }
        .year-tab-activa:hover { background: linear-gradient(135deg, #bbf7d0, #86efac); }
        .year-tab-activa.active { background: linear-gradient(135deg, #16a34a, #22c55e); color: white; border-color: #15803d; }
        .year-tab.global { display: none; } /* oculto en fila de años, aparece en controles */
        .controls { display: flex; justify-content: center; align-items: center; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; }
        .btn-global { padding: 8px 18px; background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%); color: white; border: 2px solid #7c3aed; border-radius: 8px; font-size: 13px; font-weight: bold; cursor: pointer; transition: all 0.3s; box-shadow: 0 4px 15px rgba(124,58,237,0.3); }
        .btn-global:hover { background: linear-gradient(135deg, #6d28d9 0%, #9333ea 100%); transform: translateY(-3px); }
        .btn-global.active { outline: 3px solid #fff; outline-offset: 2px; }
        .btn-update { padding: 8px 26px; background: linear-gradient(135deg, #1e293b 0%, #334155 100%); color: white; border: 2px solid #475569; border-radius: 8px; font-size: 13px; font-weight: bold; cursor: pointer; transition: all 0.3s; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3); }
        .btn-update:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4); background: linear-gradient(135deg, #334155 0%, #475569 100%); }
        .btn-update:disabled { background: #cbd5e0; cursor: not-allowed; transform: none; }
        .btn-close-year { padding: 8px 26px; background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); color: white; border: 2px solid #b91c1c; border-radius: 8px; font-size: 13px; font-weight: bold; cursor: pointer; transition: all 0.3s; }
        .btn-close-year:hover { transform: translateY(-3px); background: linear-gradient(135deg, #b91c1c 0%, #dc2626 100%); }
        .last-update { text-align: center; color: #718096; font-size: 13px; margin-bottom: 16px; }
        .summary { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 40px; }
        .summary-card { background: linear-gradient(135deg, #1e293b 0%, #334155 100%); padding: 20px; border-radius: 13px; color: white; box-shadow: 0 10px 30px rgba(0,0,0,0.3); border: 2px solid #475569; }
        .summary-card h3 { font-size: 12px; opacity: 0.9; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 1px; }
        .summary-card .value { font-size: 24px; font-weight: bold; margin-bottom: 3px; }
        .summary-card .subvalue { font-size: 15px; opacity: 0.9; }
        .summary-card .value.positive { color: #22c55e; text-shadow: 0 2px 8px rgba(34, 197, 94, 0.5); }
        .summary-card .value.negative { color: #ef4444; text-shadow: 0 2px 8px rgba(239, 68, 68, 0.5); }
        .table-wrapper { margin-top: 20px; }
        .group-scroll { overflow-x: auto; overflow-y: visible; border-radius: 10px; box-shadow: 0 5px 20px rgba(0,0,0,0.1); margin-bottom: 25px; padding-bottom: 16px; scrollbar-width: thin; scrollbar-color: #e2e8f0 transparent; }
        .group-scroll:last-child { margin-bottom: 0; }
        .group-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
        .group-scroll::-webkit-scrollbar-track { background: transparent; }
        .group-scroll::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 8px; }
        .group-scroll::-webkit-scrollbar-thumb:hover { background: #cbd5e0; }
        table { width: 100%; min-width: 1050px; border-collapse: collapse; border-radius: 10px; }
        .table-wrapper.compact-view table, .table-wrapper.compact-view .group-scroll table { min-width: 0; }
        /* En la cartera activa ya no mostramos las 5 columnas técnicas en línea. */
        .table-wrapper.active-slim table, .table-wrapper.active-slim .group-scroll table { min-width: 850px; }
        .table-wrapper.active-slim .group-section-title { min-width: 850px; }
        /* Vista activa un poco más compacta para evitar el último scroll horizontal */
        .table-wrapper.active-slim th { padding-left:8px; padding-right:8px; font-size:10px; }
        .table-wrapper.active-slim td { padding-left:8px; padding-right:8px; font-size:12px; }
        .table-wrapper.active-slim .btn-sell { padding:5px 10px; font-size:10px; }
        .table-wrapper.active-slim .btn-edit,
        .table-wrapper.active-slim .btn-delete,
        .table-wrapper.active-slim .btn-position-info { padding:5px 6px; font-size:10px; }
        .table-wrapper.active-slim .action-cell { gap:4px; }
        .group-scroll table { margin-top: 0; }
        thead { background: linear-gradient(135deg, #1e293b 0%, #334155 100%); color: white; border-bottom: 3px solid #475569; }
        th { padding: 13px 10px; text-align: center; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; white-space: nowrap; }
        td { padding: 12px 10px; border-bottom: 1px solid #e2e8f0; text-align: center; font-size: 13px; }
        tbody tr { transition: all 0.3s; }
        tbody tr:hover { background: #f7fafc; transform: scale(1.01); }
        tbody tr.sold { background: #f1f5f9; opacity: 0.8; }
        tbody tr.sold:hover { background: #e2e8f0; }
        .positive { color: #22c55e; font-weight: bold; }
        .negative { color: #ef4444; font-weight: bold; }
        .ticker { font-weight: bold; color: #2d3748; font-size: 14px; }
        .company-name { font-size: 11px; color: #718096; display: block; margin-top: 3px; }
        .sold-badge { display: inline-block; background: #64748b; color: white; padding: 2px 7px; border-radius: 5px; font-size: 9px; margin-left: 8px; font-weight: bold; }
        .sold-info { font-size: 10px; color: #64748b; display: block; margin-top: 3px; }
        .btn-sell { padding: 6px 13px; background: #dc2626; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 11px; font-weight: bold; transition: all 0.3s; }
        .btn-sell:hover { background: #b91c1c; transform: translateY(-2px); }
        .btn-edit { padding: 6px 8px; background: #3b82f6; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 11px; font-weight: bold; transition: all 0.3s; }
        .btn-edit:hover { background: #2563eb; transform: translateY(-2px); }
        .btn-delete { padding: 6px 8px; background: #64748b; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 11px; font-weight: bold; transition: all 0.3s; }
        .btn-delete:hover { background: #475569; transform: translateY(-2px); }
        .btn-position-info { padding: 6px 9px; background: #0f766e; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 11px; font-weight: bold; transition: all 0.3s; }
        .btn-position-info:hover { background: #115e59; transform: translateY(-2px); }
        .action-cell { display: flex; gap: 5px; justify-content: center; align-items: center; flex-wrap: nowrap; white-space: nowrap; }
        .section-title { font-size: 15px; font-weight: bold; color: white; margin: 35px 0 18px 0; padding: 10px 20px; background: linear-gradient(135deg, #1e293b 0%, #334155 100%); border-radius: 8px; text-align: left; border: 2px solid #475569; box-shadow: 0 4px 15px rgba(0,0,0,0.2); letter-spacing: 1.5px; }
        /* Título de cada bloque por encima de la cabecera de columnas */
        .group-section-title {
            width: 100%;
            min-width: 1050px;
            margin: 0;
            padding: 12px 24px;
            border-radius: 10px 10px 0 0;
            border-bottom: 0;
            box-shadow: none;
            text-align: center;
        }
        .group-section-title .section-icon { display:inline-block; margin-right:10px; }
        .table-wrapper.compact-view .group-section-title { min-width: 0; }
        .subtotal-row td { padding: 13px 16px !important; font-size: 14px; white-space: nowrap; }
        .section-spacer { height: 30px; background: transparent; }
        .section-row td { padding: 0 !important; border: none !important; }
        .section-row { height: 50px; }
        .subtotal-row { background: #f8fafc !important; font-weight: bold; border-top: 3px solid #1e293b !important; border-bottom: 3px solid #1e293b !important; }
        .subtotal-stocks { background: linear-gradient(135deg, #fff0e6, #ffe8d6) !important; border-top: 3px solid #f97316 !important; border-bottom: 3px solid #f97316 !important; }
        .subtotal-crypto { background: linear-gradient(135deg, #fef9c3, #fef3c7) !important; border-top: 3px solid #eab308 !important; border-bottom: 3px solid #eab308 !important; }
        .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.7); animation: fadeIn 0.3s; }
        .modal.show { display: flex; justify-content: center; align-items: center; }
        .modal-content { background: white; padding: 30px; border-radius: 15px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.5); animation: slideIn 0.3s; max-height: 90vh; overflow-y: auto; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideIn { from { transform: translateY(-50px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .modal-content h2 { color: #2d3748; margin-bottom: 20px; }
        .position-info-modal-content { max-width: 820px; padding: 0; overflow: hidden; display:flex; flex-direction:column; max-height:90vh; }
        .position-info-head { padding: 18px 24px; background: linear-gradient(135deg,#1e293b,#334155); color:white; flex:0 0 auto; }
        .position-info-head h2 { color:white; margin:0 0 4px; font-size:19px; }
        .position-info-head .position-info-subtitle { color:#cbd5e1; font-size:12px; }
        .position-info-body { padding:16px 24px 18px; overflow-y:auto; overscroll-behavior:contain; -webkit-overflow-scrolling:touch; min-height:0; }
        .position-info-body::-webkit-scrollbar { width:7px; }
        .position-info-body::-webkit-scrollbar-track { background:transparent; }
        .position-info-body::-webkit-scrollbar-thumb { background:#cbd5e1; border-radius:8px; }
        .position-info-signal { display:flex; align-items:center; justify-content:space-between; gap:14px; border-radius:10px; padding:10px 14px; margin-bottom:12px; border:1px solid transparent; }
        .position-info-signal strong { font-size:12px; letter-spacing:.7px; }
        .position-info-signal span { font-size:11px; opacity:.9; text-align:right; }
        .position-info-signal.green { background:#ecfdf5; color:#047857; border-color:#a7f3d0; }
        .position-info-signal.yellow { background:#fffbeb; color:#92400e; border-color:#fde68a; }
        .position-info-signal.red { background:#fef2f2; color:#b91c1c; border-color:#fecaca; }
        .position-info-insights { display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:10px; margin-bottom:12px; }
        .position-info-insight { border:1px solid #e2e8f0; background:white; border-radius:10px; padding:11px 14px; min-height:108px; box-shadow:0 2px 8px rgba(15,23,42,.04); }
        .position-info-insight h4 { margin:0 0 8px; color:#475569; font-size:10px; text-transform:uppercase; letter-spacing:.8px; }
        .position-info-metric-main { font-size:18px; font-weight:800; color:#1e293b; margin-bottom:4px; }
        .position-info-metric-line { display:flex; justify-content:space-between; align-items:flex-start; gap:10px; padding:3px 0; font-size:11px; color:#64748b; }
        .position-info-metric-line strong { color:#334155; text-align:right; }
        .position-info-metric-note { margin-top:5px; font-size:9px; color:#94a3b8; }
        .metric-danger { color:#dc2626 !important; }
        .metric-good { color:#059669 !important; }
        .metric-warn { color:#d97706 !important; }
        .position-info-section-title { margin:3px 0 8px; color:#64748b; font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:1px; }
        .position-info-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px 12px; }
        .position-info-card { border:1px solid #e2e8f0; background:#f8fafc; border-radius:10px; padding:12px 15px; min-height:96px; }
        .position-info-card h4 { margin:0 0 9px; color:#475569; font-size:11px; text-transform:uppercase; letter-spacing:.8px; }
        .position-info-main { font-size:16px; font-weight:800; color:#1e293b; line-height:1.45; }
        .position-info-line { display:flex; justify-content:space-between; gap:14px; padding:3px 0; font-size:12px; color:#64748b; }
        .position-info-line strong { color:#334155; }
        .position-info-stop.triggered .position-info-main { color:#dc2626; }
        .position-info-target.reached .position-info-main { color:#2563eb; }
        .position-info-target-input { display:flex; gap:8px; align-items:center; margin-top:5px; }
        .position-info-target-input input { flex:1; min-width:0; padding:8px 9px; font-size:13px; border:1px solid #cbd5e0; border-radius:7px; }
        .position-info-news { margin-top:10px; border:1px solid #e2e8f0; background:white; border-radius:10px; padding:11px 14px; }
        .position-info-news h4 { margin:0 0 10px; color:#475569; font-size:11px; text-transform:uppercase; letter-spacing:.8px; }
        .position-info-news-links { display:flex; gap:8px; flex-wrap:wrap; }
        .position-info-news-links .btn-news { width:auto; min-width:110px; margin:0; padding:8px 12px; font-size:11px; }
        .position-info-close { width:100%; margin-top:10px; padding:8px 14px; border:none; border-radius:8px; background:#e2e8f0; color:#475569; font-weight:800; cursor:pointer; }
        .position-info-close:hover { background:#cbd5e0; }
        @media (max-width: 760px) { .position-info-insights { grid-template-columns:1fr; } }
        @media (max-width: 640px) { .position-info-grid { grid-template-columns:1fr; } .position-info-modal-content { width:94%; } .position-info-signal { align-items:flex-start; flex-direction:column; } .position-info-signal span { text-align:left; } }
        .modal-content label { display: block; color: #475569; font-weight: bold; margin-bottom: 8px; margin-top: 15px; }
        .modal-content input { width: 100%; padding: 12px; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 14px; }
        .modal-buttons { display: flex; gap: 10px; margin-top: 25px; }
        .modal-buttons button { flex: 1; padding: 12px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; transition: all 0.3s; }
        .btn-confirm { background: #22c55e; color: white; }
        .btn-confirm:hover { background: #16a34a; }
        .btn-cancel { background: #e2e8f0; color: #475569; }
        .btn-cancel:hover { background: #cbd5e0; }
        .loading { display: none; text-align: center; padding: 20px; color: #667eea; font-weight: bold; }
        .loading.active { display: block; }
        .spinner { border: 4px solid #f3f3f3; border-top: 4px solid #667eea; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto 10px; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .exchange-rate { text-align: center; color: #718096; font-size: 13px; margin-top: 20px; display: flex; flex-direction: column; align-items: center; gap: 6px; }
        .exchange-rate-row { display: flex; align-items: center; justify-content: center; gap: 5px; flex-wrap: wrap; }
        .exchange-rate input { width: 74px; border: 1px solid #cbd5e0; border-radius: 5px; padding: 2px 6px; font-size: 13px; color: #2d3748; text-align: center; background: #fff; }
        .exchange-rate-note { font-size: 11px; color: #a0aec0; }
        .btn-rate-api { padding: 3px 8px; background: #0ea5e9; color: white; border: none; border-radius: 5px; font-size: 10px; font-weight: 700; cursor: pointer; transition: all 0.2s; margin-left: 3px; }
        .btn-rate-api:hover { background: #0284c7; transform: translateY(-1px); }
        .btn-rate-api:disabled { background: #94a3b8; cursor: not-allowed; transform: none; }
        .exchange-rate-status { min-height: 12px; font-size: 10px; color: #94a3b8; }
        .support-resistance { font-size: 10px; color: #64748b; min-width: 76px; }
        .support-value { color: #ef4444; font-weight: bold; font-size: 11px; }
        .resistance-value { color: #22c55e; font-weight: bold; font-size: 11px; }
        .sr-label { font-size: 9px; color: #94a3b8; display: inline; margin-right: 3px; }
        .global-year-table td { padding: 12px 16px; border-bottom: 1px solid #e2e8f0; text-align: center; font-size: 15px; }
        .global-year-table td:first-child { text-align: left; }
        #globalPanel tbody tr:nth-child(even) { background: #f8fafc; }
        #globalPanel tbody tr:hover { background: #f1f5f9; }
        .editable-price:hover { background: #ffe69c; transform: scale(1.05); }
        .manual-override { font-size: 10px; color: #856404; display: block; margin-top: 3px; }
        .target-price-cell { font-size: 11px; text-align: center; }
        tbody tr.stop-triggered { border-left: 4px solid #ef4444; }
        tbody tr.stop-triggered:hover { background: #f7fafc !important; }
        .stop-alert-banner { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; border-radius: 9px; padding: 10px 16px; margin-bottom: 16px; font-weight: bold; font-size: 14px; display: none; }
        .stop-alert-banner ul { margin: 5px 0 0 18px; font-weight: normal; font-size: 13px; }
        .stop-cell input { width: 65px; border: 1px solid #cbd5e0; border-radius: 4px; padding: 2px 4px; font-size: 11px; text-align: center; }
        .btn-refresh { padding: 3px 6px; background: #10b981; color: white; border: none; border-radius: 5px; font-size: 11px; cursor: pointer; transition: all 0.2s; }
        .btn-refresh:hover { background: #059669; }
        .btn-refresh:disabled { background: #94a3b8; cursor: not-allowed; }
        .btn-sim { padding: 8px 10px; background: #f59e0b; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: bold; transition: all 0.3s; }
        .btn-sim:hover { background: #d97706; transform: translateY(-2px); }
        .sim-result { background: #f8fafc; border-radius: 10px; padding: 15px; margin-top: 15px; border: 2px solid #e2e8f0; }
        .sim-result h4 { color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; }
        .sim-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #e2e8f0; font-size: 14px; }
        .sim-row:last-child { border-bottom: none; font-weight: bold; font-size: 15px; }
        .sim-positive { color: #16a34a; }
        .sim-negative { color: #dc2626; }
        .sim-neutral { color: #2d3748; }
        .sim-warning { background: #fef3c7; border: 1px solid #f59e0b; border-radius: 6px; padding: 8px 12px; font-size: 13px; margin-top: 10px; color: #92400e; }
        .tax-bracket { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
