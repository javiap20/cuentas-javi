function confirmSell() {
    const sellYear = parseInt(document.getElementById('sellYear').value);
    if (!sellYear || sellYear < 2010 || sellYear > 2040) { alert('⚠️ Por favor, introduce un año de venta válido'); return; }
    const position = portfolioData[String(currentSellBuyYear)].positions.find(p => p.id === currentSellTicker);
    const isUSD = position.currency === 'USD';

    position.sold = true;
    position.sellYear = sellYear;

    if (isUSD) {
        const sellPriceUSD = parseFloat(document.getElementById('sellPrice').value);
        const sellPriceEUR = parseFloat(document.getElementById('sellPriceEURfromUSD').value);
        if (!sellPriceUSD || sellPriceUSD <= 0) { alert('⚠️ Por favor, introduce un precio de venta en USD válido'); return; }
        if (!sellPriceEUR || sellPriceEUR <= 0) { alert('⚠️ Por favor, introduce el precio equivalente en EUR'); return; }
        position.sellPriceUSD = sellPriceUSD;
        position.sellPriceEUR = sellPriceEUR;
    } else {
        const sellPriceEUR = parseFloat(document.getElementById('sellPriceEUR').value);
        if (!sellPriceEUR || sellPriceEUR <= 0) { alert('⚠️ Por favor, introduce un precio de venta en EUR válido'); return; }
        position.sellPrice = sellPriceEUR;
    }

    delete position.sellCosts;
    savePortfolioData();
    closeSellModal();
    renderPortfolio();
}

function closeCurrentYear() {
    const nextYear = currentYear + 1;
    if (!confirm('¿Estás seguro de cerrar el año ' + currentYear + ' y pasar a ' + nextYear + '?\n\nLas posiciones abiertas se copiarán automáticamente al nuevo año.')) return;
    const openPositions = portfolioData[String(currentYear)].positions.filter(p => !p.sold).map(p => ({...p}));
    portfolioData[String(nextYear)] = { positions: openPositions };
    savePortfolioData();
    currentYear = nextYear;
    renderYearSelector();
    renderPortfolio();
    alert('✅ Año ' + (currentYear - 1) + ' cerrado.\n\n' + openPositions.length + ' posiciones abiertas copiadas a ' + currentYear + '.');
}

